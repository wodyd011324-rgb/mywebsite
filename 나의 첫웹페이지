        </div>
      </div>

      <div class="w-full flex justify-center">
        <div class="h-32 w-32 rounded-full overflow-hidden">
          <img src="KakaoTalk_20260108_204939323.png" class="w-full h-full object-cover" />
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="mt-6 rounded-xl border border-gray-200 bg-white">
      <div class="p-4">
        <h2 class="text-lg font-semibold">Skills</h2>
        <p class="text-sm text-gray-700">Frontend</p>
      </div>

      <div class="divide-y divide-gray-200">
        <div class="p-4">
          <p class="text-sm font-medium">Tech Stack</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <span class="rounded-full bg-gray-200 px-3 py-1 text-xs font-medium">HTML</span>
            <span class="rounded-full bg-gray-200 px-3 py-1 text-xs font-medium">CSS</span>
            <span class="rounded-full bg-gray-200 px-3 py-1 text-xs font-medium">JavaScript</span>
            <span class="rounded-full bg-[#3b3b4b] text-white px-3 py-1 text-xs font-medium">Tailwind</span>
          </div>
        </div>

        <div class="p-4">
          <p class="text-sm font-medium">Mini Cards</p>
          <div class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-2">
            <div class="rounded-lg border p-3 shadow-sm text-center">
              <p class="text-sm font-semibold">About Me</p>
              <p class="text-xs text-gray-700">한림대학교<br />4학년 재학</p>
            </div>
            <div class="rounded-lg border p-3 shadow-sm text-center">
              <p class="text-sm font-semibold">Interest</p>
              <p class="text-xs text-gray-700">Frontend · Web</p>
            </div>
            <div class="rounded-lg border p-3 shadow-sm text-center col-span-2">
              <p class="text-sm font-semibold">Currently</p>
              <p class="text-xs text-gray-700">웹 프로그래밍 수업 수강중</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="mt-6">
      <h2 class="text-lg font-semibold mb-3">Projects</h2>

      <div class="grid gap-3">
        <article class="rounded-xl border bg-white p-4 shadow-sm hover:shadow">
          <h3 class="font-semibold">Calculator</h3>
          <p class="mt-2 text-sm text-gray-700">
            JavaScript를 활용한 간단한 계산기 프로젝트입니다.
          </p>
          <div class="mt-3 flex gap-2">
            <span class="rounded-full bg-gray-200 px-3 py-1 text-xs">HTML</span>
            <span class="rounded-full bg-gray-200 px-3 py-1 text-xs">JavaScript</span>
            <span class="rounded-full bg-gray-200 px-3 py-1 text-xs">Tailwind</span>
          </div>
        </article>

        <article class="rounded-xl border bg-white p-4 shadow-sm hover:shadow">
          <h3 class="font-semibold">Portfolio Page</h3>
          <p class="mt-2 text-sm text-gray-700">
            개인 포트폴리오 웹페이지 제작 프로젝트입니다.
          </p>
          <div class="mt-3 flex gap-2">
            <span class="rounded-full bg-gray-200 px-3 py-1 text-xs">HTML</span>
            <span class="rounded-full bg-gray-200 px-3 py-1 text-xs">Tailwind</span>
          </div>
        </article>
      </div>
    </section>

    <!-- Calculator -->
    <section id="calculator" class="mt-10 mb-10">
      <h2 class="text-lg font-semibold mb-5 text-center">Calculator</h2>
      <div class="min-h-screen flex items-center justify-center p-3 sm:p-6 bg-gray-100">
        <div class="w-full max-w-[420px] bg-white rounded-xl shadow-sm border border-gray-200">
          <div class="p-4 sm:p-5">
            <input id="display" type="text" class="w-full text-right text-xl sm:text-2xl px-3 sm:px-4 py-2 sm:py-3 mb-3 rounded-lg border border-gray-300 bg-white focus:outline-none" value="0" readonly />
            <div class="keys grid grid-cols-4 gap-2 sm:gap-3">
              <button class="h-10 sm:h-11 text-sm sm:text-base rounded-lg border border-gray-600 text-gray-700 hover:bg-blue-50" data-key="7">7</button>
              <button class="h-10 sm:h-11 text-sm sm:text-base rounded-lg border border-gray-600 text-gray-700 hover:bg-blue-50" data-key="8">8</button>
              <button class="h-10 sm:h-11 text-sm sm:text-base rounded-lg border border-gray-600 text-gray-700 hover:bg-blue-50" data-key="9">9</button>
              <button class="h-10 sm:h-11 text-sm sm:text-base rounded-lg border border-blue-600 text-blue-600 hover:bg-blue-100" data-key="÷">÷</button>

              <button class="h-10 sm:h-11 text-sm sm:text-base rounded-lg border border-gray-600 text-gray-700 hover:bg-blue-50" data-key="4">4</button>
              <button class="h-10 sm:h-11 text-sm sm:text-base rounded-lg border border-gray-600 text-gray-700 hover:bg-blue-50" data-key="5">5</button>
              <button class="h-10 sm:h-11 text-sm sm:text-base rounded-lg border border-gray-600 text-gray-700 hover:bg-blue-50" data-key="6">6</button>
              <button class="h-10 sm:h-11 text-sm sm:text-base rounded-lg border border-blue-600 text-blue-600 hover:bg-blue-100" data-key="×">×</button>

              <button class="h-10 sm:h-11 text-sm sm:text-base rounded-lg border border-gray-600 text-gray-700 hover:bg-blue-50" data-key="1">1</button>
              <button class="h-10 sm:h-11 text-sm sm:text-base rounded-lg border border-gray-600 text-gray-700 hover:bg-blue-50" data-key="2">2</button>
              <button class="h-10 sm:h-11 text-sm sm:text-base rounded-lg border border-gray-600 text-gray-700 hover:bg-blue-50" data-key="3">3</button>
              <button class="h-10 sm:h-11 text-sm sm:text-base rounded-lg border border-blue-600 text-blue-600 hover:bg-blue-100" data-key="-">-</button>

              <button class="col-span-2 h-10 sm:h-11 text-sm sm:text-base rounded-lg border border-blue-600 text-gray-700 hover:bg-blue-50" data-key="0">0</button>
              <button class="h-10 sm:h-11 text-sm sm:text-base rounded-lg border border-blue-600 bg-yellow-400 text-gray-900 font-semibold hover:bg-yellow-500" data-key="C">C</button>
              <button class="h-10 sm:h-11 text-sm sm:text-base rounded-lg border border-blue-600 bg-green-600 text-white font-semibold hover:bg-green-700" data-key="=">=</button>
              <button class="h-10 sm:h-11 text-sm sm:text-base rounded-lg border border-blue-600 text-blue-600 hover:bg-blue-100" data-key="+">+</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="mt-6 rounded-xl border bg-white p-4">
      <h2 class="text-lg font-semibold">Contact</h2>
      <p class="text-sm text-gray-700">문의사항 있을 시 메일주세요.</p>
      <form class="mt-4 flex flex-col gap-3">
        <input class="rounded-lg border px-3 py-2 text-sm focus:ring-2 focus:ring-[#3b3b4b]/30"
               type="email" placeholder="you@example.com" />

        <textarea class="rounded-lg border px-3 py-2 text-sm resize-none focus:ring-2 focus:ring-[#3b3b4b]/30"
                  rows="3" placeholder="메시지를 입력하세요"></textarea>

        <button class="rounded-lg bg-[#3b3b4b] px-4 py-2 text-sm font-semibold text-white opacity-50 cursor-not-allowed"
                disabled>
          Send
        </button>
      </form>
    </section>

    <footer class="mt-6 text-center text-sm text-gray-700">
      <p>© 20215136 한림대학교 김준형</p>
    </footer>

  </div>

  <script>
    // 계산기 기능 JS
    (() => {
      const display = document.getElementById("display");
      let current = "0";

      function calculate(expr) {
        try {
          // 특수문자 변환 (÷ → /, × → *)
          expr = expr.replace(/÷/g, "/").replace(/×/g, "*");
          return Function(`return ${expr}`)();
        } catch {
          return "Error";
        }
      }

      function updateDisplay(val) {
        display.value = val;
      }

      function inputKey(key) {
        if (key === "C") {
          current = "0";
        } else if (key === "=") {
          const result = calculate(current);
          current = result.toString();
        } else {
          if (current === "0") current = "";
          current += key;
        }
        updateDisplay(current);
      }

      document.querySelectorAll(".keys button").forEach(button => {
        button.addEventListener("click", e => {
          inputKey(e.target.dataset.key);
        });
      });
    })();
  </script>
</body>
</html>
